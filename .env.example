# انسخ هذا الملف إلى .env واملأ القيم من لوحة تحكم Supabase
# Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# مفتاح Gemini لا يوضع هنا إطلاقاً: أي متغير EXPO_PUBLIC_* يُحزَم داخل
# التطبيق ويمكن استخراجه. المفتاح سرّ على الخادم:
#   supabase secrets set GEMINI_API_KEY=...
# انظر supabase/functions/README.md
