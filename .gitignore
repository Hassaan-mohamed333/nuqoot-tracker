# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local supabase credentials
# كل صور .env تُتجاهل، لا `.env` وحده: `.env.development` و`.env.production`
# داخل سلسلة أسبقية Expo وتحمل المفاتيح نفسها، وغيابهما عن التجاهل كان
# يعني تسريبها بأوّل `git add -A`.
.env*
!.env.example

# Supabase CLI local state
supabase/.temp/
